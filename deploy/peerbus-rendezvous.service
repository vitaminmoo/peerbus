[Unit]
Description=peerbus rendezvous and relay server
Documentation=https://github.com/vitaminmoo/peerbus
After=network-online.target
Wants=network-online.target

[Service]
# The Firebase service account key lets the server relay sealed push
# notifications to the Android app; drop the flag to run without push.
ExecStart=%h/bin/peerbus rendezvous -listen 0.0.0.0:47615 -fcm-credentials %h/.config/peerbus/rendezvous-push.json
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M

[Install]
WantedBy=default.target
